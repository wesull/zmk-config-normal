// This file was generated from a template. Edit it to match your keyboard.
// See https://zmk.dev/docs/development/hardware-integration/new-shield for more instructions.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/bt.h>

#define HID_IO_USAGE_FWD_TO_JOYSTICK 0
#define HID_IO_USAGE_FWD_TO_MOUSE 1
/ {
        /* Setup input-processor to intecept input and forward to new usage page  */
        zip_fwd_to_hid_joystick: zip_forward_fwd_to_hid_joystick {
                compatible = "zmk,input-processor-fwd-to-hid-joystick";
                #input-processor-cells = <0>;
        };

        /* input listener config for joystick move mode */
	analog_input_il {
		compatible = "zmk,input-listener";
		device = <&anin0>;
                input-processors = <&zip_fwd_to_hid_joystick>;
	};

        /* Setup joystick key press behavior and listener */
        /* listerer shall forward to JOYSTICK usage page */
        jskp: hid_joystick_key_press {
                compatible = "zmk,behavior-hid-joystick-key-press";
                #binding-cells = <1>;
        };
	jskp_il {
		compatible = "zmk,input-listener";
		device = <&jskp>;
                input-processors = <&zip_fwd_to_hid_joystick>;
	};



    // Define a default keymap here.
    // See https://zmk.dev/docs/development/hardware-integration/new-shield#default-keymap.
    combos {
        compatible = "zmk,combos";
        combo_bracket {
            timeout-ms = <50>;
            key-positions = <2 3>;
            bindings = <&kp LEFT_BRACKET>;
            layers = <1>;
        };
        combo_paranthesis {
            timeout-ms = <50>;
            key-positions = <8 9>;
            bindings = <&kp LEFT_PARENTHESIS>;
            layers = <1>;
        };
        combo_braces {
            timeout-ms = <50>;
            key-positions = <14 15>;
            bindings = <&kp LEFT_BRACE>;
            layers = <1>;
        };
    };

    
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp ESC     &kp Q       &kp W       &kp E       &kp R       &kp T                       //&kp Y       &kp U       &kp I       &kp O       &kp P
                &kp TAB     &kp A       &kp S       &kp D       &kp F       &kp G                       //&kp H       &kp J       &kp K       &kp L       &msc SCRL_UP
                &bt BT_CLR     &kp Z       &kp X       &kp C       &kp V       &kp B                       //&kp N       &kp M       &mkp LCLK   &mkp RCLK   &msc SCRL_DOWN
                &trans      &trans      &tog (2)    &hidiokp 0   &hidiokp 1    &kp SPACE                 //&kp LCTRL   &kp LALT    &kp LGUI    &kp LSHIFT  &trans
                &kp LEFT_GUI            &mo (1)     &kp LSHFT   &kp LALT    &kp LCTRL                 //&kp LEFT_GUI      &kp LALT      &kp LSHFT       &kp LCTRL       &mo (1)
            >;
            //  up                      right       left        button       down
        };

        lower_layer {
            bindings = <
                &kp GRAVE   &kp N1      &kp N2      &kp N3      &kp N4      &kp N5                      //&kp N6      &kp N7      &kp N8      &kp N9      &kp N0
                &kp CARET   &kp FSLH    &kp STAR    &kp MINUS   &kp PLUS    &kp EQUAL                   //&kp DQT     &kp COLON   &kp COMMA   &kp DOT     &kp SEMI
                &kp BSLH    &kp EXCL    &kp AT      &kp HASH    &kp DLLR    &kp PRCNT                   //&kp SQT     &kp AMPS    &kp GRAVE   &kp UNDERSCORE &kp QUESTION
                &trans      &trans      &tog (2)    &kp BSPC    &kp ENTER   &kp SPACE                 //&kp LCTRL   &kp LALT    &kp LGUI    &kp LSHIFT  &trans
                &kp LEFT_GUI            &mo (1)     &kp LSHFT   &kp LALT    &kp LCTRL                 //&kp LEFT_GUI      &kp LALT      &kp LSHFT       &kp LCTRL       &mo (1)
            >;
        };

         DS2_layer {
            bindings = <
                &kp ESC     &kp T       &kp LEFT    &kp RIGHT   &kp E       &kp X                       //&kp Y       &kp U       &kp I       &kp O       &kp P
                &kp TAB     &kp UP      &kp Q       &kp R       &kp F       &kp M                       //&kp H       &kp J       &kp K       &kp L       &msc SCRL_UP
                &kp DEL     &kp DOWN    &kp Z       &kp C       &kp Y       &kp B                       //&kp N       &kp M       &mkp LCLK   &mkp RCLK   &msc SCRL_DOWN
                &trans      &trans      &tog (2)    &kp ENTER   &kp BSPC    &kp SPACE                   //&kp LCTRL   &kp LALT    &kp LGUI    &kp LSHIFT  &trans
                &kp W                  &kp D        &kp A       &kp ENTER   &kp S                                //&kp LEFT_GUI      &kp LALT      &kp LSHFT       &kp LCTRL       &mo (1)
            >;
        };
    };
}; 
